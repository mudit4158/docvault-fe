<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Compose owns all visual theming (see ui/theme/Theme.kt). This XML theme exists only
        because Activity/Manifest entries require one — it just sets a NoActionBar base so
        Compose renders edge-to-edge without a system-drawn app bar underneath it.
    -->
    <style name="Theme.DocVault" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
